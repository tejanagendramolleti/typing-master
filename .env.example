# =============================================================================
# ExamTyper — example environment file.
# Copy to `.env` and adjust. NEVER commit a populated `.env`.
# =============================================================================

# ---------- Application ----------
APP_ENV=dev                       # dev | test | prod
SERVER_PORT=8080
FRONTEND_PORT=3000
# Comma-separated list of allowed CORS origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Database ----------
POSTGRES_DB=examtyper
POSTGRES_USER=examtyper
POSTGRES_PASSWORD=examtyper
# Host-side DB port (container-internal stays 5432)
POSTGRES_PORT=5432

# ---------- JWT ----------
# CHANGE THESE in any non-local deployment. Min 32 chars.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30

# ---------- Payments ----------
# mock   -> instant dev-only "Pay (test)" button
# manual -> user submits UPI txn ref, admin approves
# disabled -> hide pricing CTAs, waitlist capture only
PAYMENTS_MODE=mock

# ---------- Mail ----------
# console = log emails to stdout (default, no external service)
MAIL_MODE=console
MAIL_FROM=no-reply@examtyper.local

# ---------- AI ----------
# false = algorithmic drill generation only (default)
AI_ENABLED=false

# ---------- Seed demo users (dev only) ----------
SEED_DEMO_USERS=true
ADMIN_EMAIL=admin@examtyper.local
ADMIN_PASSWORD=Admin@12345
DEMO_FREE_EMAIL=free@examtyper.local
DEMO_FREE_PASSWORD=Free@12345
DEMO_PRO_EMAIL=pro@examtyper.local
DEMO_PRO_PASSWORD=Pro@12345
